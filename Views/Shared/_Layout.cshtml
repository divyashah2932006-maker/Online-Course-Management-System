<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#102a43" />
    <title>@ViewData["Title"] - CourseHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="sticky-top">
<nav class="navbar navbar-expand-lg navbar-dark">
 <div class="container">
  <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">C</span> CourseHub</a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
  <div class="collapse navbar-collapse" id="mainNav">
   <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Course" asp-action="Index">Courses</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Enrollment" asp-action="Create">Enroll</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
    <li class="nav-item"><a class="nav-link" asp-controller="Course" asp-action="ApiDemo">API Demo</a></li>
    @if (User.Identity?.IsAuthenticated == true) {
      <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post" class="m-0"><button class="btn btn-nav">Logout (@User.Identity.Name)</button></form></li>
    } else {
      <li class="nav-item"><a class="btn btn-nav" asp-controller="Account" asp-action="Login">Admin Login</a></li>
    }
   </ul>
  </div>
 </div>
</nav>
</header>
<main class="container page-shell">@RenderBody()</main>
<footer class="site-footer"><div class="container d-flex flex-wrap justify-content-between gap-2"><span>© 2026 CourseHub · Online Course Management System</span><span>BCA Semester VII · Gujarat University</span></div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
