@model OnlineCourseManagement.Models.Course
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="CourseId" />
<div class="row">
  <div class="col-md-6 mb-3"><label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
  <div class="col-md-6 mb-3"><label asp-for="Instructor" class="form-label"></label>
    <input asp-for="Instructor" class="form-control" /><span asp-validation-for="Instructor" class="text-danger"></span></div>
  <div class="col-md-4 mb-3"><label asp-for="Category" class="form-label"></label>
    <select asp-for="Category" class="form-select">
      <option value="">-- Select --</option>
      <option>Programming</option><option>Web Development</option><option>Database</option><option>Database Management</option><option>Data Science</option><option>Artificial Intelligence</option><option>Cybersecurity</option><option>Cloud Computing</option><option>Mobile App Development</option><option>Design</option><option>Other</option>
    </select><span asp-validation-for="Category" class="text-danger"></span></div>
  <div class="col-md-4 mb-3"><label asp-for="DurationWeeks" class="form-label"></label>
    <input asp-for="DurationWeeks" class="form-control" /><span asp-validation-for="DurationWeeks" class="text-danger"></span></div>
  <div class="col-md-4 mb-3"><label asp-for="Fee" class="form-label"></label>
    <input asp-for="Fee" class="form-control" /><span asp-validation-for="Fee" class="text-danger"></span></div>
  <div class="col-12 mb-3"><label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
</div>