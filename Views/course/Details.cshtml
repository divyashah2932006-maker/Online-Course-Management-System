@model OnlineCourseManagement.Models.Course
@{
    ViewData["Title"] = Model.Title;
    var slug = System.Text.RegularExpressions.Regex.Replace(Model.Title.ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-'); var key = Model.Category.Contains("Program") ? "programming" : Model.Category.Contains("Web") ? "web" : Model.Category.Contains("Database") ? "database" : Model.Category.Contains("Data") ? "datascience" : Model.Category.Contains("Artificial") ? "ai" : Model.Category.Contains("Cyber") ? "cyber" : Model.Category.Contains("Cloud") ? "cloud" : Model.Category.Contains("Mobile") ? "mobile" : "general";
}
<div class="mb-3"><a asp-action="Index">← Back to courses</a></div>
<div class="detail-panel">
    <div class="row g-4 align-items-start">
        <div class="col-lg-5"><img class="detail-art" src="~/images/courses/@(slug).svg" alt="@Model.Category course illustration" /></div>
        <div class="col-lg-7">
            <span class="course-category">@Model.Category</span>
            <h1 class="mt-3">@Model.Title</h1>
            <p class="text-muted">Taught by <strong>@Model.Instructor</strong></p>
            <p>@Model.Description</p>
            <div class="d-flex flex-wrap gap-4 my-4">
                <span>◷ <strong>@Model.DurationWeeks weeks</strong></span>
                <span class="detail-price">₹@Model.Fee.ToString("N0")</span>
            </div>
            <a asp-controller="Enrollment" asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-primary btn-lg">Enroll in this course</a>
            @if (User.Identity?.IsAuthenticated == true) {
                <a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary btn-lg ms-2">Edit course</a>
            }
        </div>
    </div>
</div>
