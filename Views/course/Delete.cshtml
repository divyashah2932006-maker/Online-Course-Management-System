@model OnlineCourseManagement.Models.Course
@{ ViewData["Title"] = "Delete Course"; }
<h2 class="text-danger">Delete Course?</h2>
<p>Are you sure you want to delete <strong>@Model.Title</strong>?</p>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.CourseId" />
    <button class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>